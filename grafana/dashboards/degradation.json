{
  "uid": "zeekrmate-degradation",
  "title": "Battery Degradation",
  "description": "zeekrmate battery capacity and range trend (estimates, not a measured state of health). Set the Rated capacity and Rated range variables from your Zeekr 7X variant's published spec to see percentages.",
  "tags": [
    "zeekrmate",
    "battery",
    "degradation"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "refresh": "",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Latest Reported Battery Capacity",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "zeekrmate"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "% of rated"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 70
                    },
                    {
                      "color": "yellow",
                      "value": 80
                    },
                    {
                      "color": "green",
                      "value": 90
                    }
                  ]
                }
              },
              {
                "id": "noValue",
                "value": "set Rated capacity"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "zeekrmate"
          },
          "rawSql": "SELECT ts AS time, bat_capacity_kwh AS \"Battery Capacity kWh\", ROUND((bat_capacity_kwh / CASE WHEN '${rated_capacity_kwh}' ~ '^[0-9]+(\\.[0-9]+)?$' THEN NULLIF('${rated_capacity_kwh}', '')::numeric END * 100)::numeric, 1) AS \"% of rated\" FROM positions WHERE vin = '$vin' AND  bat_capacity_kwh IS NOT NULL ORDER BY ts DESC LIMIT 1",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "description": "Unconfirmed for Zeekr: depends on bat_capacity_kwh, which has not yet been confirmed from real Zeekr 7X captures. Shows No data if the car does not report it. Percentage uses the Rated capacity variable."
    },
    {
