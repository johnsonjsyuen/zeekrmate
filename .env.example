# zeekrmate environment variables
# Copy to .env (never commit .env) and fill in your own values.
# docker compose reads .env and passes each service only the variables it
# needs (see docker-compose.yml). Wrap values containing $ in single quotes.

# --- Zeekr account (required) -------------------------------------------
# Tip from the zeekr_ev_api README: use a separate Zeekr account that the
# car is shared with, otherwise the phone app may be logged out.
ZEEKR_USERNAME=your-zeekr-account@example.com
ZEEKR_PASSWORD=change-me
# Region of the account (default AU)
ZEEKR_COUNTRY_CODE=AU

# --- Zeekr API key material (required) ----------------------------------
# zeekr_ev_api needs these values in addition to username/password.
# Obtaining them is the user's responsibility; they are not provided here.
ZEEKR_HMAC_ACCESS_KEY=
ZEEKR_HMAC_SECRET_KEY=
ZEEKR_PASSWORD_PUBLIC_KEY=
ZEEKR_PROD_SECRET=
ZEEKR_VIN_KEY=
ZEEKR_VIN_IV=

# --- Database & Grafana (required) --------------------------------------
# Replace every change-me value: the logger refuses to start with one.
# Owner password for the fordlogger database; also passed to the logger.
POSTGRES_PASSWORD=change-me
# Read-only role Grafana uses (created on first DB start).
GRAFANA_DB_PASSWORD=change-me-too
GRAFANA_ADMIN_PASSWORD=change-me-as-well
# GRAFANA_DB_USER=grafana_ro
# GRAFANA_BIND=127.0.0.1

# --- Logger --------------------------------------------------------------
# Store raw API JSON responses in the database (default: true)
# Useful for debugging and verifying parser correctness
# Set to false to save disk space once parsing is stable
FORDLOGGER_STORE_RAW_JSON=true

# Reverse geocode trip start/end and charge locations to addresses (default: true)
# Uses OpenStreetMap Nominatim (free, no API key needed)
FORDLOGGER_GEOCODING=true

# User/group the logger container runs as (must be able to write ./data).
# APP_UID=1000
# APP_GID=1000

# Where the Zeekr session file (zeekr_session.json) is kept.
# Docker sets this to /app/data (= ./data on the host). Host default: ./data
# FORDLOGGER_STATE_DIR=data
